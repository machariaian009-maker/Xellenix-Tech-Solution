# Copy this file to .env and fill values before running in development/production
# Never commit real secrets

# Server
PORT=5000
FRONTEND_URL=http://localhost:5500

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=xellenix_db

# JWT
JWT_SECRET=replace_with_strong_random_secret

# Admin (store bcrypt hash only, not plaintext password)
ADMIN_EMAIL=admin@xellenixtech.com
ADMIN_PASSWORD_HASH=

# Email (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
ADMIN_NOTIFICATION_EMAIL=admin@xellenixtech.com

# WhatsApp business number (E.164 format)
WHATSAPP_NUMBER=+254700000000

# One-time setup token used to securely set the initial admin password hash via API
# Generate a random value and set here for initial setup, then remove or change.
SETUP_TOKEN=replace_with_random_setup_token
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=xellenix_db
DB_PORT=3306
PORT=5000
JWT_SECRET=your_jwt_secret
ADMIN_EMAIL=admin@xellenixtech.com
ADMIN_PASSWORD_HASH=your_bcrypt_hash